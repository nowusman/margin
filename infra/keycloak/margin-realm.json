{
  "realm": "margin",
  "enabled": true,
  "displayName": "Welcome to Margin",
  "displayNameHtml": "Welcome to Margin",
  "accessTokenLifespan": 28800,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "clients": [
    {
      "clientId": "margin-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ],
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
    },
    {
      "clientId": "margin-api",
      "enabled": true,
      "bearerOnly": true
    }
  ],
  "groups": [
    {
      "name": "margin-admin"
    },
    {
      "name": "architecture-reviewers"
    },
    {
      "name": "architecture-admins"
    }
  ],
  "users": [
    {
      "username": "margin-admin",
      "enabled": true,
      "email": "margin-admin@example.local",
      "firstName": "Margin",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "change-me-admin",
          "temporary": true
        }
      ],
      "groups": ["margin-admin", "architecture-admins"]
    }
  ]
}
