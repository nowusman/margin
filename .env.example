# Margin deployment defaults (baseline FOSS/local-runtime profile).
# Copy to .env and override for each environment.
# Do not commit real secrets.

# -----------------------------
# Core environment
# -----------------------------
MARGIN_ENV=local
WEB_CONCURRENCY=1

# -----------------------------
# Database (PostgreSQL 18.4 + pgvector)
# -----------------------------
POSTGRES_DB=margin
POSTGRES_USER=margin
POSTGRES_PASSWORD=change-me
MARGIN_DATABASE_URL=postgresql+psycopg://margin:change-me@postgres:5432/margin

# -----------------------------
# Queue/cache
# -----------------------------
MARGIN_REDIS_URL=redis://redis:6379/0
MARGIN_CELERY_RESULT_BACKEND=redis://redis:6379/1
MARGIN_CELERY_TASK_ALWAYS_EAGER=false
# Optional host ports for local inspection; container ports remain 5432/6379.
MARGIN_POSTGRES_HOST_PORT=15432
MARGIN_REDIS_HOST_PORT=16379

# -----------------------------
# Local retrieval index
# -----------------------------
MARGIN_EMBEDDING_PROVIDER_ID=local-sentence-transformers
MARGIN_EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
MARGIN_EMBEDDING_INDEX_VERSION=bge-small-en-v1.5-v1
MARGIN_EMBEDDING_MODEL_CACHE_DIR=/models/sentence-transformers
MARGIN_RERANKER_PROVIDER_ID=local-cross-encoder
MARGIN_RERANKER_MODEL_ID=BAAI/bge-reranker-base
MARGIN_RERANKER_MODEL_CACHE_DIR=/models/sentence-transformers

# -----------------------------
# Retrieval context budget
# -----------------------------
# Characters of context an answer is read under. A domain may configure its own
# budget, which takes precedence over this global setting.
MARGIN_CONTEXT_BUDGET_CHARS=32000

# -----------------------------
# Rich document and diagram tooling
# -----------------------------
MARGIN_PLANTUML_CMD=plantuml

# -----------------------------
# Object storage
# -----------------------------
MINIO_ROOT_USER=margin
MINIO_ROOT_PASSWORD=change-me-minio
MARGIN_OBJECT_STORE_ENDPOINT=http://minio:9000
MARGIN_OBJECT_STORE_BUCKET=margin-artifacts
MARGIN_OBJECT_STORE_REGION=us-east-1
MARGIN_OBJECT_STORE_ACCESS_KEY_ID=margin
MARGIN_OBJECT_STORE_SECRET_ACCESS_KEY=change-me-minio
MARGIN_OBJECT_STORE_LOCAL_PATH=.margin/object-store
# Optional: override host ports that map to MinIO container (useful if 9000/9001 are in use)
# Default changed to avoid common host conflicts; container ports remain 9000/9001
MINIO_HOST_PORT=19000
MINIO_CONSOLE_PORT=19001

# -----------------------------
# API auth and token verification
# -----------------------------
MARGIN_AUTH_MODE=oidc
MARGIN_AUTH_DEPLOYMENT_PROFILE=external_oidc
MARGIN_OIDC_ISSUER_URL=
MARGIN_OIDC_AUDIENCE=margin-api
MARGIN_OIDC_CLIENT_ID=margin-web
MARGIN_OIDC_JWKS_URL=
MARGIN_OIDC_GROUPS_CLAIM=groups
MARGIN_OIDC_EMAIL_CLAIM=email
MARGIN_OIDC_HS256_SECRET=
MARGIN_OIDC_VERIFY_SIGNATURE=false
MARGIN_KEYCLOAK_PROFILE_ENABLED=false
# Local development only. Must stay false in production.
MARGIN_AUTH_HEADER_FALLBACK=true

# -----------------------------
# Worker runtime
# -----------------------------
MARGIN_WORKER_LOG_LEVEL=INFO
MARGIN_WORKER_CONCURRENCY=1

# -----------------------------
# Optional low-profile Keycloak profile
# -----------------------------
KEYCLOAK_POSTGRES_DB=keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_PUBLIC_URL=http://localhost:8082

# -----------------------------
# Authorization backend
# -----------------------------
MARGIN_AUTHZ_BACKEND=postgres_permission_cache

# -----------------------------
# Frontend auth behavior
# -----------------------------
VITE_AUTH_AUTO_REDIRECT=true
VITE_OIDC_ISSUER=http://localhost:8082/realms/margin
VITE_OIDC_CLIENT_ID=margin-web

# -----------------------------
# Model Context Protocol server
# -----------------------------
MARGIN_API_URL=http://127.0.0.1:8000
MARGIN_MCP_USER=mcp-reader
MARGIN_MCP_GROUPS=architect
MARGIN_MCP_TIMEOUT=60

# -----------------------------
# Agent runtime
# -----------------------------
MARGIN_AGENT_SANDBOX_ROOT=.margin-agent-sandbox

# -----------------------------
# Domain playbooks
# -----------------------------
MARGIN_PLAYBOOK_PATHS=
